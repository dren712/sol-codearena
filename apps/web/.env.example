# ---------------------------------------------------------------------------
# Copy to `.env` (apps/web/.env) and fill in what you need. Every value here is
# optional — the app runs with sensible Devnet defaults out of the box.
# ---------------------------------------------------------------------------

# Prisma database. SQLite file relative to apps/web/prisma/.
DATABASE_URL="file:./dev.db"

# Solana cluster used for every server-side read: devnet | testnet | mainnet-beta
SOLANA_CLUSTER="devnet"

# Dedicated RPC endpoint. The public Devnet RPC rate-limits server workloads,
# so set this for anything beyond a local demo.
# SOLANA_RPC_URL="https://api.devnet.solana.com"

# Absolute origin, used for Open Graph tags, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI tutor (optional) ---------------------------------------------------
# With neither key set, the tutor uses its built-in Solana heuristics and needs
# no network access. With one set, the tutor upgrades to a real model.

# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- OpenRouter (takes priority over the two above) ------------------------
# Any OpenRouter model id works; defaults to the free apodex-1.1-mini.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="apodex/apodex-1.1-mini:free"
# AI_FALLBACK_MODEL="minimax/minimax-m3.1-flash:free"

# --- Validator sandbox (optional) ------------------------------------------

# Milliseconds a single submission may run before it is terminated.
VALIDATOR_TIMEOUT_MS=4000

# Maximum accepted submission size, in bytes.
VALIDATOR_MAX_CODE_BYTES=100000

# --- Grading policy (optional) ---------------------------------------------

# When true, a completion is only recorded if its transaction and Completion PDA
# are actually verified against the cluster. Leave false for classroom demos
# where the program is not deployed yet.
REQUIRE_ONCHAIN_VERIFICATION=false